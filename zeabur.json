# Homerun - Prediction Market Trading Platform
# Zeabur Deployment Configuration

# This project requires:
# 1. PostgreSQL database (Zeabur managed)
# 2. Redis (Zeabur managed or embedded)
# 3. Multi-service deployment

metadata:
  name: homerun
  description: Prediction market arbitrage platform

services:
  backend:
    build:
      context: ./backend
      dockerfile: ./Dockerfile
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - APP_SECRETS_KEY=${APP_SECRETS_KEY}
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - POLYMARKET_PRIVATE_KEY=${POLYMARKET_PRIVATE_KEY:-}
      - POLYMARKET_API_KEY=${POLYMARKET_API_KEY:-}
      - POLYMARKET_API_SECRET=${POLYMARKET_API_SECRET:-}
      - POLYMARKET_API_PASSPHRASE=${POLYMARKET_API_PASSPHRASE:-}
      - POLYGON_RPC_URL=${POLYGON_RPC_URL:-https://rpc-mainnet.matic.quiknode.pro}
      - POLYGON_WS_URL=${POLYGON_WS_URL:-wss://polygon-bor-rpc.publicnode.com}
      - DATABASE_WORKER_POOL_SIZE=${DATABASE_WORKER_POOL_SIZE:-30}
      - DATABASE_WORKER_MAX_OVERFLOW=${DATABASE_WORKER_MAX_OVERFLOW:-4}
      - SMART_WALLET_POOL_TARGET_SIZE=${SMART_WALLET_POOL_TARGET_SIZE:-25}
    ports:
      - 8000
    health_check:
      path: /health/live
      interval: 15s
      timeout: 5s
      retries: 5

  worker-trading:
    build:
      context: ./backend
      dockerfile: ./Dockerfile
    command: python -m workers.host trading
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - APP_SECRETS_KEY=${APP_SECRETS_KEY}
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - HOMERUN_PROCESS_ROLE=worker
      - HOMERUN_WORKER_PLANE=trading
      - DATABASE_WORKER_POOL_SIZE=${DATABASE_WORKER_POOL_SIZE:-30}
      - DATABASE_WORKER_MAX_OVERFLOW=${DATABASE_WORKER_MAX_OVERFLOW:-4}
    depends_on:
      - backend

  worker-news:
    build:
      context: ./backend
      dockerfile: ./Dockerfile
    command: python -m workers.host news
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - APP_SECRETS_KEY=${APP_SECRETS_KEY}
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - HOMERUN_PROCESS_ROLE=worker
      - HOMERUN_WORKER_PLANE=news
      - DATABASE_WORKER_POOL_SIZE=${DATABASE_WORKER_POOL_SIZE:-30}
      - DATABASE_WORKER_MAX_OVERFLOW=${DATABASE_WORKER_MAX_OVERFLOW:-4}
    depends_on:
      - backend

  worker-discovery:
    build:
      context: ./backend
      dockerfile: ./Dockerfile
    command: python -m workers.host discovery
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - APP_SECRETS_KEY=${APP_SECRETS_KEY}
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - HOMERUN_PROCESS_ROLE=worker
      - HOMERUN_WORKER_PLANE=discovery
      - DATABASE_WORKER_POOL_SIZE=${DATABASE_WORKER_POOL_SIZE:-30}
      - DATABASE_WORKER_MAX_OVERFLOW=${DATABASE_WORKER_MAX_OVERFLOW:-4}
    depends_on:
      - backend

  frontend:
    build:
      context: ./frontend
      dockerfile: ./Dockerfile
    ports:
      - 3000
    depends_on:
      - backend

databases:
  postgres:
    plan: hobby
    version: "16"

addons:
  redis:
    plan: hobby
