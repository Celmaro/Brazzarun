# syntax=docker/dockerfile:1.7
ARG PYTHON_VERSION=3.12

FROM python:${PYTHON_VERSION}-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ libffi-dev libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY backend/requirements.txt backend/requirements-trading.txt ./

RUN pip install --upgrade pip wheel \
    && pip install --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install -r requirements.txt \
    && pip install -r requirements-trading.txt

FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:${PATH}" HOMERUN_PROCESS_ROLE=server

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 curl tini libpango-1.0-0 libpangoft2-1.0-0 \
        libharfbuzz0b libfreetype6 libffi8 libgdk-pixbuf-2.0-0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1000 homerun \
    && useradd --system --uid 1000 --gid 1000 --create-home --shell /bin/bash homerun

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app/backend
COPY --chown=homerun:homerun . /app/backend

RUN chown homerun:homerun /app /app/backend \
    && install -d -o homerun -g homerun /app/data /app/backend/.runtime /app/backend/.runtime/locks

USER homerun

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
